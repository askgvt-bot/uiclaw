{
  "id": "uiclaw",
  "name": "UIClaw",
  "description": "Rich dynamic web interfaces for OpenClaw agents",
  "version": "0.1.0",
  "channels": ["uiclaw"],
  "skills": ["../../skills/uiclaw"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "number",
        "default": 3800,
        "description": "Port for the UIClaw web server"
      },
      "host": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "Host to bind the web server to"
      }
    }
  },
  "uiHints": {
    "port": { "label": "Web Server Port", "placeholder": "3800" },
    "host": { "label": "Bind Host", "placeholder": "127.0.0.1" }
  }
}
