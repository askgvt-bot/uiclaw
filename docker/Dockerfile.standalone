# UIClaw Standalone — Clean OpenClaw + UIClaw from GitHub
# Usage: docker build -f docker/Dockerfile.standalone -t uiclaw-standalone .
#        docker run -p 3800:3800 -e OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789 uiclaw-standalone

FROM node:22-slim

# System deps
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm tsx

# 1. Install OpenClaw
RUN npm install -g openclaw

# 2. Clone UIClaw from GitHub (latest)
WORKDIR /app
RUN git clone https://github.com/askgvt-bot/uiclaw.git .

# 3. Install deps + build frontend
RUN pnpm install --no-frozen-lockfile
RUN cd packages/web && npx vite build

# Runtime config
ENV UICLAW_HOST=0.0.0.0
ENV UICLAW_PORT=3800
ENV OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789

EXPOSE 3800

CMD ["tsx", "packages/server/src/index.ts"]
